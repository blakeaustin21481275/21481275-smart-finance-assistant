        "import gradio as gr\n",
        "import pandas as pd\n",
        "from pandas.errors import ParserError\n",
        "\n",
        "\n",
        "def calculate_total_revenue(csv_file):\n",
        "    try:\n",
        "        # 1. Check if a file was uploaded\n",
        "        if csv_file is None or not hasattr(csv_file, \"name\"):\n",
        "            return \"Error: Please upload a file before processing.\"\n",
        "\n",
        "        # NEW: Check file type\n",
        "        if not csv_file.name.lower().endswith(\".csv\"):\n",
        "            return \"Error: Please upload a CSV file only.\"\n",
        "\n",
        "        # 2. Read uploaded CSV file\n",
        "        try:\n",
        "            df = pd.read_csv(csv_file.name)\n",
        "        except ParserError:\n",
        "            return \"Error: Please upload a valid CSV file.\"\n",
        "\n",
        "        # 5. Check if CSV is empty\n",
        "        if df.empty:\n",
        "            return \"Error: The uploaded file contains no data.\"\n",
        "\n",
        "        # 3. Check required columns\n",
        "        try:\n",
        "            quantity = df[\"quantity\"]\n",
        "            price = df[\"price\"]\n",
        "        except KeyError:\n",
        "            return \"Error: CSV must contain quantity and price columns.\"\n",
        "\n",
        "        # 4. Ensure numeric data\n",
        "        try:\n",
        "            df[\"quantity\"] = pd.to_numeric(df[\"quantity\"])\n",
        "            df[\"price\"] = pd.to_numeric(df[\"price\"])\n",
        "        except (ValueError, TypeError):\n",
        "            return \"Error: Quantity and price must be numeric values.\"\n",
        "\n",
        "        # Create revenue column\n",
        "        df[\"revenue\"] = df[\"quantity\"] * df[\"price\"]\n",
        "\n",
        "        # Calculate total revenue\n",
        "        total_revenue = df[\"revenue\"].sum()\n",
        "\n",
        "        return f\"Total Revenue: ${total_revenue:,.2f}\"\n",
        "\n",
        "    # NEW: Handle wrong file type errors\n",
        "    except FileNotFoundError:\n",
        "        return \"Error: The selected file could not be found.\"\n",
        "\n",
        "    # General unexpected errors\n",
        "    except Exception as e:\n",
        "        return f\"An unexpected error occurred: {str(e)}\"\n",
        "\n",
        "\n",
        "# Create Gradio interface\n",
        "demo = gr.Interface(\n",
        "    fn=calculate_total_revenue,\n",
        "    inputs=gr.File(label=\"Upload CSV File\"),\n",
        "    outputs=gr.Textbox(label=\"Revenue Summary\"),\n",
        "    title=\"Revenue Calculator\",\n",
        "    description=\"Upload a CSV file with columns: product, quantity, price\"\n",
        ")\n",
        "\n",
